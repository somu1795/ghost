# Database
DATABASE_URL=postgresql://ghost:ghost@postgres:5432/ghost?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://ghost:ghost@postgres:5432/ghost?sslmode=disable
POSTGRES_PASSWORD=ghost

# Redis (used by ioredis and bullmq)
REDIS_URL=redis://redis:6379

# App Configuration
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=changeme_in_production_min_32_chars!
BETTER_AUTH_URL=http://localhost:3000
BOOTSTRAP_JWT_SECRET=changeme_in_production_min_32_chars!

# Storage
STORAGE_DIR=/data/ghost-storage

# Git reference (for snapshot builds)
GHOST_GIT_REPO_URL=https://github.com/somu1795/ghost
GHOST_GIT_REVISION=main

# Optional: Observability
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
